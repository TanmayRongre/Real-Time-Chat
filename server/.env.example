# Server Environment
NODE_ENV=production
PORT=5000

# Client URLs (comma-separated allowed origins for Express + Socket.io)
CLIENT_URL=http://localhost:5173,https://your-app-name.vercel.app

# Render Keep-Alive URL (Render automatically sets RENDER_EXTERNAL_URL)
RENDER_EXTERNAL_URL=https://your-backend-name.onrender.com

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/realtime_chat?retryWrites=true&w=majority

# Security (Strong secret key for JWT session tokens)
JWT_SECRET=generate_a_random_32_or_64_character_hex_secret

# Email Delivery
# Option 1 (Recommended for Render): Brevo API Key (300 free emails/day to ANY email address in the world, zero custom domain needed)
BREVO_API_KEY=

# Option 2: Resend API key (HTTPS port 443 - free for sending to your registered account email)
RESEND_API_KEY=

# Option 2: Gmail SMTP with 16-character Google App Password (works locally)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
